# gameclockd: the game clock LED matrix daemon (docs/adr/0010).
# Installed to /etc/systemd/system/ by scripts/deploy.sh.
[Unit]
Description=Game clock LED matrix daemon
Documentation=https://github.com/jmayeur/gameclock
# Both drive the same GPIO pins: starting either one stops the other.
Conflicts=clock.svc.service

[Service]
Type=simple
# Driver tuning without a rebuild, for example:
#   GAMECLOCKD_ARGS=--led-slowdown-gpio=1 --led-show-refresh
EnvironmentFile=-/etc/default/gameclockd
# Starts as root to map GPIO. hzeller drops to the 'daemon' user after init.
# 8 PWM bits for the clock (docs/adr/0015). The driver reads flags in order,
# so a --led-pwm-bits value in GAMECLOCKD_ARGS replaces this one.
ExecStart=/usr/local/bin/gameclockd --led-pwm-bits=8 $GAMECLOCKD_ARGS
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
